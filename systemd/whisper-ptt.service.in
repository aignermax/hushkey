[Unit]
Description=whisper-ptt: local push-to-talk dictation
After=graphical-session.target
# Wayland inserts text through ydotoold, which is either the distribution's
# ydotool.service or the ydotoold.service we install when there is none. Naming
# both is safe: Wants= on a missing unit is not an error, so one template covers
# either arrangement and X11, where neither exists.
Wants=ydotool.service ydotoold.service
After=ydotool.service ydotoold.service

[Service]
ExecStart=@DIR@/.venv/bin/python @DIR@/dictate.py
Environment=YDOTOOL_SOCKET=%t/.ydotool_socket
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
