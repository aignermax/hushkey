[Unit]
Description=ydotoold — virtual input device for whisper-ptt (Wayland)
Documentation=https://github.com/ReimuNotMoe/ydotool

[Service]
# Runs as the user, not root: the udev rule in udev/99-whisper-ptt-uinput.rules
# gives the 'input' group rw on /dev/uinput, and the user is in that group.
ExecStart=@YDOTOOLD@ --socket-path=%t/.ydotool_socket --socket-perm=0600
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
