#!/bin/sh
# Remove owned system configuration on removal. User data is retained unless
# purging. Drop privileges before removing files inside any user's home.
case "${1:-}" in
  remove|purge) rm -f /etc/udev/rules.d/99-whisper-ptt-uinput.rules ;;
esac
if [ "${1:-}" = purge ]; then
  getent passwd | while IFS=: read -r name password uid gid info home shell; do
    case "$home" in /|"") continue ;; /*) ;; *) continue ;; esac
    [ "$name" != root ] || continue
    [ -f "$home/.local/share/whisper-ptt/.deb-managed" ] || continue
    sudo -u "$name" rm -f "$home/.config/systemd/user/whisper-ptt.service" \
      "$home/.config/systemd/user/ydotoold.service" \
      "$home/.local/share/applications/hushkey.desktop" || true
    sudo -u "$name" rm -rf "$home/.local/share/whisper-ptt" \
      "$home/.local/share/hushkey" "$home/.local/state/whisper-ptt" || true
    sudo -u "$name" XDG_RUNTIME_DIR="/run/user/$uid" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
      systemctl --user daemon-reload >/dev/null 2>&1 || true
  done
fi
exit 0
