#!/bin/sh
# Stop every dpkg-managed user's service, including PackageKit removals which
# carry no caller identity. Do not stop the distro's shared ydotool service.
case "${1:-}" in
  remove|deconfigure)
    getent passwd | while IFS=: read -r name password uid gid info home shell; do
      case "$home" in /|"") continue ;; /*) ;; *) continue ;; esac
      [ "$name" != root ] || continue
      [ -f "$home/.local/share/whisper-ptt/.deb-managed" ] || continue
      sudo -u "$name" XDG_RUNTIME_DIR="/run/user/$uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        systemctl --user disable --now whisper-ptt.service ydotoold.service \
        >/dev/null 2>&1 || true
    done
    ;;
esac
exit 0
