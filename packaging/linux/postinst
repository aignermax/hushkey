#!/bin/sh
# hushkey postinst: hand the payload to the installing user and run install.sh
# as that user (venv + dependencies + systemd user service). Deferred graphical
# setup uses this same script through pkexec when no desktop user is identifiable.
set -e

PAYLOAD="${HUSHKEY_PAYLOAD:-/opt/hushkey}"

manual_hint() {
    echo "hushkey: open hushkey from your desktop application menu to finish setup."
}

# Which user's home should receive the install?
#
# `sudo dpkg -i` sets SUDO_USER, and that used to be the only case handled. But
# a graphical install (GNOME Software, gdebi, double-clicking the .deb) runs the
# maintainer script through pkexec/PackageKit instead: SUDO_USER is unset and
# logname fails for want of a controlling terminal. The old one-liner then left
# USER_NAME empty, printed the hint into a log nobody reads and exited 0 — dpkg
# reported success while nothing but /opt had been touched.
#
# So try the identities in order of trustworthiness and stop at the first hit.
resolve_user() {
    # 1. sudo, and pkexec, each state the caller outright.
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
        printf '%s\n' "$SUDO_USER"
        return 0
    fi
    if [ -n "${PKEXEC_UID:-}" ]; then
        name="$(getent passwd "$PKEXEC_UID" 2>/dev/null | cut -d: -f1)"
        if [ -n "$name" ] && [ "$name" != root ]; then
            printf '%s\n' "$name"
            return 0
        fi
    fi
    # 2. A controlling terminal, when there is one.
    name="$(logname 2>/dev/null || true)"
    if [ -n "$name" ] && [ "$name" != root ]; then
        printf '%s\n' "$name"
        return 0
    fi
    # 3. PackageKit leaves no caller identity at all, so fall back to the
    #    logged-in desktop user. Only accept an unambiguous answer: with two
    #    users logged in, guessing would install into the wrong home.
    #    Only real desktop sessions count — greeter sessions (gdm/sddm) and
    #    remote logins would create false ambiguity, and a lone greeter would
    #    install into the display manager's home.
    if command -v loginctl >/dev/null 2>&1; then
        name=""
        for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk 'NF {print $1}'); do
            [ "$(loginctl show-session "$sid" -p Class --value 2>/dev/null)" = "user" ] \
                || continue
            case "$(loginctl show-session "$sid" -p Type --value 2>/dev/null)" in
                x11|wayland) ;;
                *) continue ;;
            esac
            user="$(loginctl show-session "$sid" -p Name --value 2>/dev/null)"
            if [ -n "$user" ] && [ "$user" != "root" ]; then
                name="${name:+$name
}$user"
            fi
        done
        name="$(printf '%s\n' "$name" | sed '/^$/d' | sort -u)"
        if [ -n "$name" ] && [ "$(printf '%s\n' "$name" | wc -l)" -eq 1 ]; then
            printf '%s\n' "$name"
            return 0
        fi
    fi
    return 1
}

USER_NAME="$(resolve_user || true)"
if [ -z "$USER_NAME" ] || [ "$USER_NAME" = "root" ]; then
    echo "hushkey: installed to /opt/hushkey."
    manual_hint
    exit 0
fi

USER_ID="$(id -u "$USER_NAME" 2>/dev/null || true)"
USER_HOME="$(getent passwd "$USER_NAME" 2>/dev/null | cut -d: -f6 || true)"
if [ -z "$USER_ID" ] || [ -z "$USER_HOME" ]; then
    echo "hushkey: could not resolve user '$USER_NAME'."
    manual_hint
    exit 0
fi

DEST="$USER_HOME/.local/share/whisper-ptt"
# Homes are user-controlled, including symlinked parent directories. Never
# copy, chown, or write markers there with root's filesystem privileges.
sudo -u "$USER_NAME" mkdir -p "$DEST"
sudo -u "$USER_NAME" cp -r "$PAYLOAD/." "$DEST/"
sudo -u "$USER_NAME" touch "$DEST/.deb-managed"
sudo -u "$USER_NAME" rm -f "$DEST/.setup-version"

# PackageKit cannot prompt for sudo inside a user shell. Prepare Wayland's
# root-owned input access here, while the package manager already has root.
SESSION_TYPE=x11
if command -v loginctl >/dev/null 2>&1; then
    for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk 'NF {print $1}'); do
        if [ "$(loginctl show-session "$sid" -p Name --value 2>/dev/null)" = "$USER_NAME" ] &&
           [ "$(loginctl show-session "$sid" -p Type --value 2>/dev/null)" = wayland ]; then
            SESSION_TYPE=wayland
        fi
    done
fi
if [ "$SESSION_TYPE" = wayland ] && [ "$(id -u)" = 0 ]; then
    install -m 0644 "$PAYLOAD/udev/99-whisper-ptt-uinput.rules" /etc/udev/rules.d/99-whisper-ptt-uinput.rules
    udevadm control --reload-rules
    if [ ! -e /dev/uinput ]; then modprobe uinput; fi
    udevadm trigger --subsystem-match=misc --sysname-match=uinput || true
    printf 'uinput\n' > /etc/modules-load.d/uinput.conf
    if ! id -nG "$USER_NAME" | tr ' ' '\n' | grep -qx input; then
        usermod -aG input "$USER_NAME"
        echo "hushkey: input access granted; log out and back in before dictating."
    fi
fi

# systemctl --user needs the user's runtime environment even via sudo.
if ! sudo -u "$USER_NAME" \
        HOME="$USER_HOME" \
        HUSHKEY_PACKAGE_INSTALL=1 \
        XDG_SESSION_TYPE="$SESSION_TYPE" \
        XDG_RUNTIME_DIR="/run/user/$USER_ID" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$USER_ID/bus" \
        bash "$DEST/install.sh"; then
    echo "hushkey: automatic setup failed."
    manual_hint
    exit 1
fi

if [ -f "$PAYLOAD/.release-version" ]; then
    sudo -u "$USER_NAME" cp "$PAYLOAD/.release-version" "$DEST/.setup-version"
fi

exit 0
