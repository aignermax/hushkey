# Shell scripts must stay LF everywhere — Windows checkouts (autocrlf)
# would otherwise break bash and the deb maintainer scripts.
*.sh text eol=lf
packaging/linux/postinst text eol=lf
packaging/linux/prerm text eol=lf
packaging/linux/postrm text eol=lf
# Test data compared byte for byte (an xz archive and what it holds).
rust/crates/hushkey-app/tests/data/* binary
